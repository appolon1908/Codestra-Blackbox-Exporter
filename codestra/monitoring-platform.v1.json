{
  "schemaVersion": 1,
  "repository": "appolon1908-hue/Codestra-Blackbox-Exporter",
  "service": "blackbox-exporter",
  "plane": "telemetry-data-plane",
  "controller": "appolon1908-hue/Middleware- (service catalog, monitoring state, incidents)",
  "secretsAuthority": "appolon1908-hue/Codestra-OpenBao",
  "credentialPolicy": {
    "credentialFree": true,
    "openbaoWorkloadIdentity": null,
    "openbaoPathPrefix": null,
    "secretReferences": null,
    "secretMaterialInGit": false,
    "credentialsFromRuntimeFilesOnly": false
  },
  "listener": {
    "address": "0.0.0.0:9115",
    "exposure": "private_observability_network_only",
    "hostPortPublished": false,
    "internetIngress": false
  },
  "prometheus": {
    "scrapeJob": "codestra-targets",
    "targetId": "blackbox-exporter",
    "consumerRepository": "appolon1908-hue/Codestra-Prometheus",
    "metricsOnly": true
  },
  "middlewareCatalog": {
    "serviceId": "blackbox-exporter",
    "metricsProfile": "prometheus",
    "logsProfile": "alloy",
    "tracesProfile": "not-applicable",
    "expectedStateSource": "release image digest and config bundle digest"
  },
  "businessEffects": {
    "providerWrites": false,
    "businessApiCalls": false
  },
  "runtimeApplyAuthorized": false,
  "probePolicy": {
    "allowedHttpMethods": [
      "GET",
      "HEAD"
    ],
    "forbiddenHttpMethods": [
      "POST",
      "PUT",
      "PATCH",
      "DELETE"
    ],
    "allowedProbers": [
      "http",
      "tcp",
      "dns",
      "icmp"
    ],
    "requestBodiesAllowed": false,
    "businessApiTargetsAllowed": false,
    "targetAuthority": "appolon1908-hue/Codestra-Prometheus codestra/blackbox/targets-production.json",
    "moduleAuthority": "config/blackbox.yml",
    "openbaoHealthModule": "https_openbao_health"
  }
}
