{
  "schema": "kyyow.platform-component.v1",
  "repository": "appolon1908-hue/Codestra-Blackbox-Exporter",
  "component": "blackbox-exporter",
  "authority": "synthetic-probes",
  "exposure": "private",
  "native_ports": [
    9115
  ],
  "inputs": [
    "approved-target-registry"
  ],
  "outputs": [
    "alloy:metrics"
  ],
  "controls": [
    "targets are selected from an operator allowlist; arbitrary user-supplied targets are prohibited",
    "private, link-local, metadata, and control-plane destinations are denied",
    "probe logs redact query strings and authorization material",
    "no public probe API"
  ],
  "identity": {
    "authority": "appolon1908-hue/Keycloak",
    "workload_identity_required": true,
    "anonymous_admin_access": false
  },
  "secrets": {
    "authority": "appolon1908-hue/Codestra-OpenBao",
    "secrets_in_git": false,
    "environment_plaintext_secrets": false
  },
  "operations": {
    "middleware_is_sole_odoo_writer": true,
    "grafana_read_only": true,
    "superset_read_only": true
  },
  "activation": {
    "source_contract_complete": true,
    "runtime_evidence_complete": false,
    "production_activation_authorized": false
  }
}

